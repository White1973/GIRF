# ==============================================================================
# DIPE evaluation deployment configuration
#
# Single-node 8-GPU setup (L20X, 143GB each) on this machine:
#   - 1 DIPE inference backend instance on GPU 6, port 8106
#   - 2 judge instances on GPU 4-5, ports 8200-8201
#   - backend/judge load balancers on ports 7771/7772
#
# Fill/override the values below before running scripts/eval/*.sh
# ==============================================================================

# Hosts running inference backends. For single-node deployment list only the
# local IP (space-separated). Add more IPs for multi-node deployment.
# All evaluation services in the scripts below run on this same node. Use the
# loopback address for health checks/API calls; binding is handled separately
# with SERVICE_HOST=0.0.0.0 so stale NIC addresses cannot prevent startup.
export LOCAL_IP="127.0.0.1"
export WORKER_HOSTS="127.0.0.1"
export SERVICE_HOST="0.0.0.0"

# Absolute path to the DIPE repository root (parent of scripts/, ckpt/, ...).
export PROJECT_PATH="code/RoPE/DIPE_EntityAwareGIRF"
export LMUData="${LMUData:-data/LMUData}"

# SFT checkpoint to evaluate. Use the SFT (instruction-tuned) model, NOT the
# pretrain baseline or the DeepSpeed checkpoint-* shards.
export EVAL_MODEL_PATH="code/RoPE/DIPE/ckpt/girf_sft_llava_next_seed42"

# Output directory label and run mode. SAVE_NAME becomes the output subdir name.
export SAVE_NAME="qwen25_3b_sft_dipe"
export MODE="infer"
