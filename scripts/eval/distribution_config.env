#!/usr/bin/env bash
# Shared, portable defaults for GIRF evaluation launchers.
# Every value may be overridden by exporting it before sourcing this file.

_GIRF_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "${_GIRF_CONFIG_DIR}/../.." && pwd)}"

EVAL_PYTHON="${EVAL_PYTHON:-$(command -v python3 || command -v python)}"
MODEL_PYTHON="${MODEL_PYTHON:-${TRAIN_PYTHON:-$(command -v python3 || command -v python)}}"
EVAL_VLLM="${EVAL_VLLM:-$(command -v vllm || true)}"
VLMEVALKIT_DIR="${VLMEVALKIT_DIR:-${PROJECT_ROOT}/VLMEvalKit}"
LMUData="${LMUData:-${PROJECT_ROOT}/data/LMUData}"
CHECKPOINT_ROOT="${CHECKPOINT_ROOT:-${PROJECT_ROOT}/checkpoints}"

EVAL_MODEL_PATH="${EVAL_MODEL_PATH:-${MODEL_PATH:-}}"
EVAL_PROCESSOR_PATH="${EVAL_PROCESSOR_PATH:-${PROCESSOR_PATH:-${EVAL_MODEL_PATH}}}"
JUDGE_MODEL_PATH="${JUDGE_MODEL_PATH:-${MODEL_ROOT:-${PROJECT_ROOT}/models}/Qwen2.5-7B-Instruct}"

LOCAL_IP="${LOCAL_IP:-localhost}"
SERVICE_HOST="${SERVICE_HOST:-0.0.0.0}"
BACKEND_INSTANCES="${BACKEND_INSTANCES:-6:8106}"
JUDGE_INSTANCES="${JUDGE_INSTANCES:-4:8200 5:8201}"
BACKEND_BALANCER_PORT="${BACKEND_BALANCER_PORT:-7771}"
JUDGE_BALANCER_PORT="${JUDGE_BALANCER_PORT:-7772}"
API_KEY="${API_KEY:-sk-abc123}"
SAVE_NAME="${SAVE_NAME:-girf_eval}"

export PROJECT_ROOT EVAL_PYTHON MODEL_PYTHON EVAL_VLLM VLMEVALKIT_DIR LMUData
export CHECKPOINT_ROOT EVAL_MODEL_PATH EVAL_PROCESSOR_PATH JUDGE_MODEL_PATH
export LOCAL_IP SERVICE_HOST BACKEND_INSTANCES JUDGE_INSTANCES
export BACKEND_BALANCER_PORT JUDGE_BALANCER_PORT API_KEY SAVE_NAME

unset _GIRF_CONFIG_DIR
